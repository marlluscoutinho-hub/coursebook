{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "course.schema.json",
  "title": "Curso",
  "type": "object",
  "required": ["id", "title", "book", "description", "modules"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 20, "description": "Deve citar o livro." },
    "book": {
      "type": "object",
      "required": ["title", "authors"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "authors": { "type": "string" },
        "edition": { "type": "string" },
        "year": { "type": "integer" }
      }
    },
    "contentPolicy": { "enum": ["paraphrase", "quotes"], "default": "paraphrase" },
    "profile": { "type": "string", "default": "padrao" },
    "customCallouts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^x-[a-z0-9-]+$" },
      "uniqueItems": true
    },
    "modules": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Pastas dos módulos, em ordem." },
    "status": { "enum": ["planned", "in_development", "published"] }
  }
}
