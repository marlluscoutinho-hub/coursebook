{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson.schema.json",
  "title": "Aula",
  "type": "object",
  "required": ["id", "title", "blocks"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Estável: o progresso depende dele." },
    "title": { "type": "string" },
    "kind": { "enum": ["standard", "lab"], "default": "standard" },
    "profile": { "type": "string", "description": "Sobrescreve o perfil do curso." },
    "pages": { "type": "string" },
    "blocks": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "object", "required": ["type", "file"], "additionalProperties": false,
            "properties": { "type": { "enum": ["intro", "text", "summary"] }, "file": { "type": "string", "pattern": "\\.md$" } } },
          { "$ref": "lab.schema.json" }
        ]
      }
    }
  }
}
